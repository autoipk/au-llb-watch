name: AU LLB watcher

on:
  schedule:
    - cron: "*/10 * * * *"
  workflow_dispatch:
    inputs:
      mode:
        description: "check = normal run, test = send test alerts, status = show status"
        default: "check"
        type: choice
        options: [check, test, status]

permissions:
  contents: write

concurrency:
  group: au-watch
  cancel-in-progress: false

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 8
    env:
      TZ: Asia/Kolkata
      AUWATCH_CLOUD: "1"
      MODE: ${{ inputs.mode }}
      NTFY_TOPIC: ${{ secrets.NTFY_TOPIC }}
      MAIL_TO: ${{ secrets.MAIL_TO }}
      GMAIL_USER: ${{ secrets.GMAIL_USER }}
      GMAIL_APP_PASS: ${{ secrets.GMAIL_APP_PASS }}
      WHATSAPP_PHONE: ${{ secrets.WHATSAPP_PHONE }}
      CALLMEBOT_APIKEY: ${{ secrets.CALLMEBOT_APIKEY }}
    steps:
      - uses: actions/checkout@v4

      - name: Check for new notifications
        run: |
          if [ -z "$NTFY_TOPIC" ] && [ -z "$MAIL_TO" ]; then
            echo "::error::No alert channel set. Add NTFY_TOPIC and MAIL_TO under Settings > Secrets and variables > Actions."
            exit 1
          fi
          case "$MODE" in
            test)   python3 au_watch.py --test ;;
            status) python3 au_watch.py --status ;;
            *)      python3 au_watch.py ;;
          esac

      - name: Save what has been seen
        if: always()
        run: |
          [ -f state.json ] || exit 0
          git config user.name  "au-watch-bot"
          git config user.email "au-watch-bot@users.noreply.github.com"
          git add state.json
          git diff --cached --quiet && exit 0
          git commit -q -m "update watcher state"
          for i in 1 2 3; do
            git push -q && exit 0
            git pull -q --rebase -X theirs || true
            sleep 5
          done
          echo "::warning::Could not save state this round; next run will retry."
